{
  "experiment": "temporal-transaction-gnn-v2",
  "framework": "TensorFlow/Keras",
  "tensorflow_version": "2.21.0",
  "compute_device": "CPU",
  "split_directory": "Dataset (PaySim)/chronological_splits",
  "split_step_ranges": {
    "train": [
      1,
      450
    ],
    "validation": [
      451,
      600
    ],
    "test": [
      601,
      743
    ]
  },
  "numeric_features": [
    "step",
    "amount",
    "oldbalanceOrg",
    "newbalanceOrig",
    "oldbalanceDest",
    "newbalanceDest"
  ],
  "categorical_features": [
    "type"
  ],
  "target_column": "isFraud",
  "excluded_model_inputs": [
    "isFraud",
    "isFlaggedFraud",
    "nameOrig",
    "nameDest"
  ],
  "edge_relations": [
    "prior_sender_to_current_sender",
    "prior_recipient_to_current_sender",
